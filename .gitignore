# ─────────────────────────────────────────
# .gitignore — Agentic GPA Calculation System
# ─────────────────────────────────────────

# Environment variables — NEVER commit this
.env

# Python cache
__pycache__/
*.py[cod]
*$py.class
*.pyo

# Virtual environment
venv/
env/
.venv/

# Database files
*.db
*.sqlite
*.sqlite3

# Google credentials — NEVER commit these
credentials/

# VS Code
.vscode/

# OS files
.DS_Store
Thumbs.db

# Pytest cache
.pytest_cache/
*.coverage
htmlcov/

# Distribution / packaging
dist/
build/
*.egg-info/

# Alembic — keep versions folder but ignore compiled
alembic/versions/*.pyc

# Streamlit
.streamlit/secrets.toml
